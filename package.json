{
  "name": "matrix-notepad",
  "version": "1.0.0",
  "description": "A Matrix-themed desktop notepad built with Electron + TypeScript",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.renderer.json",
    "start": "electron dist/main.js",
    "dev": "concurrently \"tsc --watch\" \"tsc -p tsconfig.renderer.json --watch\" \"electron . --no-sandbox\"",
    "package": "electron-builder",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "dompurify": "^3.4.0",
    "marked": "^18.0.0",
    "mermaid": "^11.14.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.matrix-notepad.app",
    "productName": "Morpheus",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "output.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "installerIcon": "output.ico",
      "uninstallerIcon": "output.ico",
      "include": "build/installer.nsh"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "output.ico",
      "package.json"
    ]
  }
}
